# Root build context for every image (services and the whatsapp-bot): keep images small and secrets out.
# The bot's Dockerfile needs its own sources plus the workspace manifests; apps/web stays out.
.git
.github
docs
evals
infra
apps/web/*
!apps/web/package.json
packages/ui/*
!packages/ui/package.json
apps/whatsapp-bot/dist
apps/whatsapp-bot/coverage
apps/whatsapp-bot/.turbo
**/tests
**/node_modules
**/.next
**/.turbo
**/dist
**/coverage
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.hypothesis
**/.import_linter_cache
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
