{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "packages/flags/registry.json"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI", "PORT", "NEXT_TELEMETRY_DISABLED", "DO_NOT_TRACK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["CW_WEB_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/docs/legal/*.md"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/consumers/**",
        "$TURBO_ROOT$/docs/legal/*.md",
        "$TURBO_ROOT$/docs/web/screens.md",
        "$TURBO_ROOT$/packages/contracts/openapi/*.json"
      ],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
