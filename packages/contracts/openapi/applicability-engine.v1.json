{
  "components": {
    "schemas": {
      "Applicability": {
        "description": "Outcome of evaluating a specification against a profile.",
        "enum": [
          "applies",
          "not_applicable",
          "unsure"
        ],
        "title": "Applicability",
        "type": "string"
      },
      "DecisionOut": {
        "description": "One decision: the result of one rule version for one version of a business's profile.\n``needs_review`` is true when the result is unsure or the confidence is below the review\nthreshold; ``evaluated`` lists every predicate in the specification, left to right.",
        "properties": {
          "as_of_fy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of Fy"
          },
          "business_id": {
            "format": "uuid",
            "title": "Business Id",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "decided_at": {
            "format": "date-time",
            "title": "Decided At",
            "type": "string"
          },
          "decision_id": {
            "format": "uuid",
            "title": "Decision Id",
            "type": "string"
          },
          "evaluated": {
            "items": {
              "$ref": "#/components/schemas/PredicateResultOut"
            },
            "title": "Evaluated",
            "type": "array"
          },
          "needs_review": {
            "title": "Needs Review",
            "type": "boolean"
          },
          "profile_version": {
            "title": "Profile Version",
            "type": "integer"
          },
          "result": {
            "$ref": "#/components/schemas/Applicability"
          },
          "rule_version_id": {
            "format": "uuid",
            "title": "Rule Version Id",
            "type": "string"
          },
          "trigger": {
            "$ref": "#/components/schemas/Trigger"
          }
        },
        "required": [
          "decision_id",
          "business_id",
          "rule_version_id",
          "result",
          "confidence",
          "needs_review",
          "profile_version",
          "as_of_fy",
          "trigger",
          "decided_at",
          "evaluated"
        ],
        "title": "DecisionOut",
        "type": "object"
      },
      "EvaluateIn": {
        "additionalProperties": false,
        "properties": {
          "fy": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Financial year the profile's per-year attributes are read for, such as 2026-27; absent means the current one in India",
            "title": "Fy"
          },
          "rule_version_id": {
            "description": "A published rule version",
            "format": "uuid",
            "title": "Rule Version Id",
            "type": "string"
          }
        },
        "required": [
          "rule_version_id"
        ],
        "title": "EvaluateIn",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Page_DecisionOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DecisionOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Send as cursor to read the next page; null on the last page",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "Page[DecisionOut]",
        "type": "object"
      },
      "Page_ReviewItemOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReviewItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Send as cursor to read the next page; null on the last page",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "Page[ReviewItemOut]",
        "type": "object"
      },
      "PredicateKind": {
        "enum": [
          "structured",
          "free_text"
        ],
        "title": "PredicateKind",
        "type": "string"
      },
      "PredicateResultOut": {
        "description": "One predicate of the rule's specification: its outcome, the confidence behind it and\nwhy. ``predicate`` is the kernel's predicate mapping, as the rule version stores it.",
        "properties": {
          "attribute": {
            "title": "Attribute",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PredicateKind"
          },
          "needs_review": {
            "title": "Needs Review",
            "type": "boolean"
          },
          "outcome": {
            "$ref": "#/components/schemas/Applicability"
          },
          "predicate": {
            "additionalProperties": true,
            "title": "Predicate",
            "type": "object"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "attribute",
          "kind",
          "description",
          "predicate",
          "outcome",
          "confidence",
          "reason",
          "needs_review"
        ],
        "title": "PredicateResultOut",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "Resolution": {
        "description": "What the reviewer settled on: a result for the decision, or no decision at all.",
        "enum": [
          "applies",
          "not_applicable",
          "dismiss"
        ],
        "title": "Resolution",
        "type": "string"
      },
      "ResolveIn": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "description": "Why: kept with the item",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Note",
            "type": "string"
          },
          "resolution": {
            "$ref": "#/components/schemas/Resolution",
            "description": "applies or not_applicable appends a decision with trigger review and publishes applicability.decided; dismiss closes the item and appends nothing"
          },
          "resolved_by": {
            "description": "The reviewer settling the item; a signed-in user's token overrides it",
            "format": "uuid",
            "title": "Resolved By",
            "type": "string"
          }
        },
        "required": [
          "resolution",
          "note",
          "resolved_by"
        ],
        "title": "ResolveIn",
        "type": "object"
      },
      "ReviewItemOut": {
        "description": "A decision waiting for a reviewer, or settled. ``decision`` is the decision under review:\nthe latest of the business and the rule version while the item is open. ``resolved_by`` is\nthe reviewer, or null when a later decision that needs no review settled the item;\n``resolution_decision_id`` is the decision a resolution to applies or not_applicable\nappended.",
        "properties": {
          "business_id": {
            "format": "uuid",
            "title": "Business Id",
            "type": "string"
          },
          "decision": {
            "$ref": "#/components/schemas/DecisionOut"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "opened_at": {
            "format": "date-time",
            "title": "Opened At",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/ReviewReason"
          },
          "resolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Resolution"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolution_decision_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution Decision Id"
          },
          "resolved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          },
          "resolved_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved By"
          },
          "rule_version_id": {
            "format": "uuid",
            "title": "Rule Version Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ReviewStatus"
          }
        },
        "required": [
          "item_id",
          "business_id",
          "rule_version_id",
          "reason",
          "status",
          "opened_at",
          "decision",
          "resolution",
          "resolved_by",
          "resolved_at",
          "note",
          "resolution_decision_id"
        ],
        "title": "ReviewItemOut",
        "type": "object"
      },
      "ReviewReason": {
        "description": "Why a decision needs a person.",
        "enum": [
          "free_text",
          "low_confidence"
        ],
        "title": "ReviewReason",
        "type": "string"
      },
      "ReviewStatus": {
        "enum": [
          "open",
          "resolved"
        ],
        "title": "ReviewStatus",
        "type": "string"
      },
      "Trigger": {
        "description": "What caused an evaluation; the ``trigger`` of ``applicability.decided``. ``review`` is a\nperson's resolution of a review item.",
        "enum": [
          "manual",
          "rule_published",
          "profile_updated",
          "review"
        ],
        "title": "Trigger",
        "type": "string"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "An access token from the identity service. Read when CW_AUTH_MODE is dual or token; required when it is token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "compliancewatch-applicability-engine",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/applicability-engine/businesses/{business_id}/decisions": {
      "get": {
        "operationId": "list_decisions_v1_applicability_engine_businesses__business_id__decisions_get",
        "parameters": [
          {
            "in": "path",
            "name": "business_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Business Id",
              "type": "string"
            }
          },
          {
            "description": "Only the decisions of this rule version; the first is the latest",
            "in": "query",
            "name": "rule_version_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only the decisions of this rule version; the first is the latest",
              "title": "Rule Version Id"
            }
          },
          {
            "description": "Items per page, 1 to 200",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Items per page, 1 to 200",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "The next_cursor of the previous page; absent for the first page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The next_cursor of the previous page; absent for the first page",
              "title": "Cursor"
            }
          },
          {
            "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_DecisionOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "A business's decisions, newest first, a page at a time",
        "tags": [
          "applicability-engine"
        ]
      },
      "post": {
        "description": "Every evaluation stores a new decision and publishes ``applicability.decided``, so this\nis also how a decision is recomputed after the profile changed. A predicate the engine\ncannot decide (free text, an attribute the profile has not set) is unsure, never guessed,\nand an unsure result needs review. 404 when the rulebook has no such rule version or the\nprofile service no such business; 409 when the version is not published; 503 when either\nservice cannot be read.",
        "operationId": "evaluate_v1_applicability_engine_businesses__business_id__decisions_post",
        "parameters": [
          {
            "in": "path",
            "name": "business_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Business Id",
              "type": "string"
            }
          },
          {
            "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
              "title": "X-Tenant-Id"
            }
          },
          {
            "description": "A new value for each new request, such as a UUID; a retry sends the same value and gets the first response back for 24 hours",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "A new value for each new request, such as a UUID; a retry sends the same value and gets the first response back for 24 hours",
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[!-~]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Precondition Required"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Evaluate a published rule version against the business's profile, and store it",
        "tags": [
          "applicability-engine"
        ]
      }
    },
    "/v1/applicability-engine/decisions/{decision_id}": {
      "get": {
        "operationId": "read_decision_v1_applicability_engine_decisions__decision_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Decision Id",
              "type": "string"
            }
          },
          {
            "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
