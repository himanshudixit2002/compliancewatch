{
  "components": {
    "schemas": {
      "Channel": {
        "description": "Where a notification is delivered.",
        "enum": [
          "whatsapp",
          "email"
        ],
        "title": "Channel",
        "type": "string"
      },
      "ConsentSource": {
        "description": "How the opt-in or opt-out reached us.",
        "enum": [
          "whatsapp_keyword",
          "web_onboarding",
          "api",
          "support"
        ],
        "title": "ConsentSource",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Outcome": {
        "enum": [
          "sent",
          "failed",
          "deferred",
          "not_opted_in",
          "duplicate"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "PreferenceIn": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "opted_in": {
            "title": "Opted In",
            "type": "boolean"
          },
          "quiet_hours_end": {
            "anyOf": [
              {
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quiet Hours End"
          },
          "quiet_hours_start": {
            "anyOf": [
              {
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quiet Hours Start"
          },
          "source": {
            "$ref": "#/components/schemas/ConsentSource"
          }
        },
        "required": [
          "opted_in",
          "source"
        ],
        "title": "PreferenceIn",
        "type": "object"
      },
      "PreferenceOut": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "opted_in": {
            "title": "Opted In",
            "type": "boolean"
          },
          "quiet_hours_end": {
            "title": "Quiet Hours End",
            "type": "string"
          },
          "quiet_hours_start": {
            "title": "Quiet Hours Start",
            "type": "string"
          },
          "recipient": {
            "title": "Recipient",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ConsentSource"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "channel",
          "recipient",
          "opted_in",
          "source",
          "language",
          "quiet_hours_start",
          "quiet_hours_end",
          "updated_at"
        ],
        "title": "PreferenceOut",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SendIn": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "default": 1,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Attempt",
            "type": "integer"
          },
          "business_id": {
            "format": "uuid",
            "title": "Business Id",
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "notification_id": {
            "format": "uuid",
            "title": "Notification Id",
            "type": "string"
          },
          "obligation_id": {
            "format": "uuid",
            "title": "Obligation Id",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          },
          "recipient": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Recipient",
            "type": "string"
          },
          "template_key": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Template Key",
            "type": "string"
          }
        },
        "required": [
          "notification_id",
          "obligation_id",
          "business_id",
          "channel",
          "recipient",
          "template_key"
        ],
        "title": "SendIn",
        "type": "object"
      },
      "SendOut": {
        "properties": {
          "dedupe_key": {
            "title": "Dedupe Key",
            "type": "string"
          },
          "error": {
            "default": "",
            "title": "Error",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "notification_id": {
            "format": "uuid",
            "title": "Notification Id",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "provider_message_id": {
            "default": "",
            "title": "Provider Message Id",
            "type": "string"
          },
          "scheduled_for": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled For"
          }
        },
        "required": [
          "outcome",
          "notification_id",
          "dedupe_key",
          "language"
        ],
        "title": "SendOut",
        "type": "object"
      },
      "TemplateOut": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "meta_name": {
            "title": "Meta Name",
            "type": "string"
          },
          "placeholders": {
            "items": {
              "type": "string"
            },
            "title": "Placeholders",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "key",
          "channel",
          "language",
          "status",
          "meta_name",
          "placeholders",
          "body"
        ],
        "title": "TemplateOut",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "compliancewatch-notification",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/notification/ping": {
      "get": {
        "operationId": "ping_v1_notification_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping V1 Notification Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Router liveness",
        "tags": [
          "notification"
        ]
      }
    },
    "/v1/notification/preferences/{channel}/{recipient}": {
      "get": {
        "operationId": "get_preference_v1_notification_preferences__channel___recipient__get",
        "parameters": [
          {
            "in": "path",
            "name": "channel",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          {
            "in": "path",
            "name": "recipient",
            "required": true,
            "schema": {
              "title": "Recipient",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferenceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "The recorded preference, 404 when the recipient never opted in or out",
        "tags": [
          "notification"
        ]
      },
      "put": {
        "operationId": "set_preference_v1_notification_preferences__channel___recipient__put",
        "parameters": [
          {
            "in": "path",
            "name": "channel",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Channel"
            }
          },
          {
            "in": "path",
            "name": "recipient",
            "required": true,
            "schema": {
              "title": "Recipient",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferenceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreferenceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Record an opt-in or opt-out for a channel and recipient",
        "tags": [
          "notification"
        ]
      }
    },
    "/v1/notification/send": {
      "post": {
        "operationId": "send_v1_notification_send_post",
        "parameters": [
          {
            "description": "Tenant UUID; required until identity issues tokens",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID; required until identity issues tokens",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Send one notification: dedupe, consent, quiet hours, render, deliver",
        "tags": [
          "notification"
        ]
      }
    },
    "/v1/notification/templates": {
      "get": {
        "operationId": "templates_v1_notification_templates_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TemplateOut"
                  },
                  "title": "Response Templates V1 Notification Templates Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Every message template with its approval status",
        "tags": [
          "notification"
        ]
      }
    }
  }
}
