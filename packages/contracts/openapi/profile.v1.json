              {
                "type": "null"
              }
            ],
            "description": "2025-26",
            "title": "As Of Fy"
          },
          "key": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Key",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/AttributeSource",
            "default": "user_input"
          },
          "state": {
            "$ref": "#/components/schemas/ValueState",
            "default": "known"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "key"
        ],
        "title": "AttributeChangeIn",
        "type": "object"
      },
      "AttributeOut": {
