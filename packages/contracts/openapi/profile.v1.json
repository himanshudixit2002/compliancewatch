            "title": "Key",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/AttributeSource"
          },
          "state": {
            "$ref": "#/components/schemas/ValueState"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "value": {
            "title": "Value"
          }
        },
        "required": [
          "key",
          "state",
          "as_of_fy",
          "source",
          "updated_at"
