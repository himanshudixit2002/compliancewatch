{
  "components": {
    "schemas": {
      "ClauseIn": {
        "additionalProperties": false,
        "properties": {
          "clause_ref": {
            "examples": [
              "en.p3"
            ],
            "pattern": "^(?:[a-z]{2,3}\\.)?p[1-9][0-9]{0,3}$",
            "title": "Clause Ref",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "text": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "clause_ref",
          "text"
        ],
        "title": "ClauseIn",
        "type": "object"
      },
      "ClauseOut": {
        "properties": {
          "clause_id": {
            "format": "uuid",
            "title": "Clause Id",
            "type": "string"
          },
          "clause_ref": {
            "title": "Clause Ref",
            "type": "string"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "clause_id",
          "clause_ref",
          "ordinal",
          "page",
          "text"
        ],
        "title": "ClauseOut",
        "type": "object"
      },
      "DocumentIn": {
        "additionalProperties": false,
        "description": "A parsed regulator document. The id in the path must be the first half of ``sha256``.",
        "properties": {
          "clauses": {
            "items": {
              "$ref": "#/components/schemas/ClauseIn"
            },
            "maxItems": 2000,
            "minItems": 1,
            "title": "Clauses",
            "type": "array"
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "external_ref": {
            "default": "",
            "examples": [
              "01/2026-Central Tax"
            ],
            "maxLength": 200,
            "title": "External Ref",
            "type": "string"
          },
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "language": {
            "examples": [
              "en"
            ],
            "maxLength": 8,
            "minLength": 1,
            "title": "Language",
            "type": "string"
          },
          "media_type": {
            "examples": [
              "application/pdf"
            ],
            "maxLength": 80,
            "minLength": 1,
            "title": "Media Type",
            "type": "string"
          },
          "parser_version": {
            "examples": [
              "pdf@1"
            ],
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_-]*@[0-9]+$",
            "title": "Parser Version",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "raw_uri": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Uri"
          },
          "regulator": {
            "examples": [
              "CBIC"
            ],
            "maxLength": 40,
            "minLength": 1,
            "title": "Regulator",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 2000,
            "title": "Title",
            "type": "string"
          },
          "url": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "sha256",
          "regulator",
          "doc_type",
          "url",
          "language",
          "media_type",
          "parser_version",
          "fetched_at",
          "clauses"
        ],
        "title": "DocumentIn",
        "type": "object"
      },
      "DocumentOut": {
        "properties": {
          "clauses": {
            "items": {
              "$ref": "#/components/schemas/ClauseOut"
            },
            "title": "Clauses",
            "type": "array"
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "external_ref": {
            "title": "External Ref",
            "type": "string"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "parser_version": {
            "title": "Parser Version",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "regulator": {
            "title": "Regulator",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "source_id",
          "sha256",
          "regulator",
          "doc_type",
          "external_ref",
          "url",
          "title",
          "language",
          "media_type",
          "parser_version",
          "published_at",
          "clauses"
        ],
        "title": "DocumentOut",
        "type": "object"
      },
      "DocumentType": {
        "enum": [
          "notification",
          "circular",
          "press_release",
          "act_amendment"
        ],
        "title": "DocumentType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RegisteredOut": {
        "properties": {
          "clause_ids": {
            "additionalProperties": {
              "format": "uuid",
              "type": "string"
            },
            "description": "Clause ref to the id every service derives",
            "title": "Clause Ids",
            "type": "object"
          },
          "created": {
            "title": "Created",
            "type": "boolean"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "metadata_differs": {
            "description": "Fields whose submitted value differs from the stored one; the stored wins",
            "items": {
              "type": "string"
            },
            "title": "Metadata Differs",
            "type": "array"
          }
        },
        "required": [
          "document_id",
          "created",
          "clause_ids",
          "metadata_differs"
        ],
        "title": "RegisteredOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "compliancewatch-rulebook",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/rulebook/documents/{document_id}": {
      "get": {
        "operationId": "read_document_v1_rulebook_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "A stored document with its clauses in order",
        "tags": [
          "rulebook",
          "documents"
        ]
      },
      "put": {
        "operationId": "register_document_v1_rulebook_documents__document_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          },
          {
            "description": "Shared secret for writes (CW_RULEBOOK_WRITE_TOKEN)",
            "in": "header",
            "name": "x-cw-write-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Shared secret for writes (CW_RULEBOOK_WRITE_TOKEN)",
              "title": "X-Cw-Write-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredOut"
                }
              }
            },
            "description": "Stored now"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Register a parsed regulator document; idempotent for the same clauses",
        "tags": [
          "rulebook",
          "documents"
        ]
      }
    },
    "/v1/rulebook/ping": {
      "get": {
        "operationId": "ping_v1_rulebook_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping V1 Rulebook Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping",
        "tags": [
          "rulebook"
        ]
      }
    }
  }
}
