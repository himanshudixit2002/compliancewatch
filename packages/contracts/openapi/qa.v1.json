      }
    },
    "/v1/qa/ping": {
      "get": {
        "operationId": "ping_v1_qa_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping V1 Qa Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping",
        "tags": [
          "qa"
        ]
      }
    }
  }
}
