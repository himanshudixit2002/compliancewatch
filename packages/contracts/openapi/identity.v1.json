{
  "components": {
    "schemas": {
      "ConsentIn": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "default": "",
            "maxLength": 2000,
            "title": "Evidence",
            "type": "string"
          },
          "granted": {
            "default": true,
            "title": "Granted",
            "type": "boolean"
          },
          "notice_version": {
            "default": "",
            "description": "Required when granting",
            "maxLength": 40,
            "title": "Notice Version",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ConsentPurpose"
          },
          "recorded_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded By"
          },
          "source": {
            "$ref": "#/components/schemas/ConsentSource"
          },
          "subject": {
            "description": "User id or E.164 number",
            "maxLength": 254,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "purpose",
          "source"
        ],
        "title": "ConsentIn",
        "type": "object"
      },
      "ConsentOut": {
        "properties": {
          "evidence": {
            "title": "Evidence",
            "type": "string"
          },
          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "notice_version": {
            "title": "Notice Version",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ConsentPurpose"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "recorded_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recorded By"
          },
          "source": {
            "$ref": "#/components/schemas/ConsentSource"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "id",
          "subject",
          "purpose",
          "granted",
          "source",
          "notice_version",
          "evidence",
          "recorded_by",
          "recorded_at"
        ],
        "title": "ConsentOut",
        "type": "object"
      },
      "ConsentPurpose": {
        "enum": [
          "terms",
          "privacy_notice",
          "profile_processing",
          "whatsapp_reminders",
          "email_reminders",
          "analytics"
        ],
        "title": "ConsentPurpose",
        "type": "string"
      },
      "ConsentSource": {
        "enum": [
          "web_onboarding",
          "whatsapp_keyword",
          "api",
          "support"
        ],
        "title": "ConsentSource",
        "type": "string"
      },
      "ConsentStateOut": {
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "notice_version": {
            "title": "Notice Version",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ConsentPurpose"
          },
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ConsentSource"
          }
        },
        "required": [
          "purpose",
          "granted",
          "notice_version",
          "since",
          "source"
        ],
        "title": "ConsentStateOut",
        "type": "object"
      },
      "ConsentSummaryOut": {
        "properties": {
          "history": {
            "items": {
              "$ref": "#/components/schemas/ConsentOut"
            },
            "title": "History",
            "type": "array"
          },
          "states": {
            "items": {
              "$ref": "#/components/schemas/ConsentStateOut"
            },
            "title": "States",
            "type": "array"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "states",
          "history"
        ],
        "title": "ConsentSummaryOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PlanOut": {
        "properties": {
          "amount_paise": {
            "title": "Amount Paise",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "period": {
            "title": "Period",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "amount_paise",
          "period",
          "description"
        ],
        "title": "PlanOut",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SubscriptionIn": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "plan_key": {
            "pattern": "^(owner_monthly|ca_seat_monthly)$",
            "title": "Plan Key",
            "type": "string"
          }
        },
        "required": [
          "plan_key",
          "email",
          "name"
        ],
        "title": "SubscriptionIn",
        "type": "object"
      },
      "SubscriptionOut": {
        "properties": {
          "checkout_url": {
            "title": "Checkout Url",
            "type": "string"
          },
          "plan_key": {
            "title": "Plan Key",
            "type": "string"
          },
          "provider_subscription_id": {
            "title": "Provider Subscription Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "plan_key",
          "provider_subscription_id",
          "status",
          "started_at",
          "checkout_url"
        ],
        "title": "SubscriptionOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "WebhookOut": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "provider_subscription_id": {
            "title": "Provider Subscription Id",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "kind",
          "provider_subscription_id",
          "status"
        ],
        "title": "WebhookOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "compliancewatch-identity",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/identity/billing/plans": {
      "get": {
        "operationId": "plans_v1_identity_billing_plans_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlanOut"
                  },
                  "title": "Response Plans V1 Identity Billing Plans Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The plans on offer (placeholders until pricing is decided)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/identity/billing/subscriptions": {
      "post": {
        "operationId": "start_subscription_v1_identity_billing_subscriptions_post",
        "parameters": [
          {
            "description": "Tenant UUID; required until the identity service issues tokens",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID; required until the identity service issues tokens",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Start a subscription with the billing provider",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/identity/billing/webhook": {
      "post": {
        "operationId": "billing_webhook_v1_identity_billing_webhook_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-razorpay-signature",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Razorpay-Signature",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Provider webhook: verified against the webhook secret before it is read",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/identity/consents": {
      "get": {
        "operationId": "consent_status_v1_identity_consents_get",
        "parameters": [
          {
            "in": "query",
            "name": "subject",
            "required": true,
            "schema": {
              "maxLength": 254,
              "minLength": 1,
              "title": "Subject",
              "type": "string"
            }
          },
          {
            "description": "Tenant UUID; required until the identity service issues tokens",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID; required until the identity service issues tokens",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentSummaryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The current state per purpose for a subject, with the full history",
        "tags": [
          "identity"
        ]
      },
      "post": {
        "operationId": "record_consent_v1_identity_consents_post",
        "parameters": [
          {
            "description": "Tenant UUID; required until the identity service issues tokens",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID; required until the identity service issues tokens",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Record a consent or a withdrawal (append-only)",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/identity/ping": {
      "get": {
        "operationId": "ping_v1_identity_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping V1 Identity Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Router liveness",
        "tags": [
          "identity"
        ]
      }
    }
  }
}
