{
  "components": {
    "schemas": {
      "GateOut": {
        "description": "One gate. ``previous_value`` is the same gate's value in the previous run of the suite\nand profile, and ``drift`` this value less that one; both are null without one of them.",
        "properties": {
          "drift": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drift"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "previous_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Value"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "name",
          "metric",
          "threshold",
          "value",
          "passed",
          "previous_value",
          "drift"
        ],
        "title": "GateOut",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Profile": {
        "description": "The harness's profiles: ``ci`` gates the scripted and fake providers, ``nightly`` a real\nmodel behind the gateway.",
        "enum": [
          "ci",
          "nightly"
        ],
        "title": "Profile",
        "type": "string"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RunIn": {
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile",
            "default": "ci",
            "description": "ci: scripted and fake providers, no tokens; nightly: a real model through the gateway"
          },
          "suite": {
            "$ref": "#/components/schemas/Suite",
            "description": "The harness suite to run"
          }
        },
        "required": [
          "suite"
        ],
        "title": "RunIn",
        "type": "object"
      },
      "RunOut": {
        "description": "One run with every gate, in the harness's order.",
        "properties": {
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "failed_gates": {
            "items": {
              "type": "string"
            },
            "title": "Failed Gates",
            "type": "array"
          },
          "gates": {
            "items": {
              "$ref": "#/components/schemas/GateOut"
            },
            "title": "Gates",
            "type": "array"
          },
          "gates_total": {
            "title": "Gates Total",
            "type": "integer"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "previous_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Run Id"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "regressed_gates": {
            "items": {
              "type": "string"
            },
            "title": "Regressed Gates",
            "type": "array"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "suite": {
            "$ref": "#/components/schemas/Suite"
          }
        },
        "required": [
          "run_id",
          "suite",
          "profile",
          "started_at",
          "completed_at",
          "passed",
          "gates_total",
          "failed_gates",
          "regressed_gates",
          "previous_run_id",
          "gates"
        ],
        "title": "RunOut",
        "type": "object"
      },
      "RunSummaryOut": {
        "description": "One run without its gates. ``passed`` is true when every gate passed.",
        "properties": {
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "failed_gates": {
            "items": {
              "type": "string"
            },
            "title": "Failed Gates",
            "type": "array"
          },
          "gates_total": {
            "title": "Gates Total",
            "type": "integer"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "previous_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Run Id"
          },
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "regressed_gates": {
            "items": {
              "type": "string"
            },
            "title": "Regressed Gates",
            "type": "array"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "suite": {
            "$ref": "#/components/schemas/Suite"
          }
        },
        "required": [
          "run_id",
          "suite",
          "profile",
          "started_at",
          "completed_at",
          "passed",
          "gates_total",
          "failed_gates",
          "regressed_gates",
          "previous_run_id"
        ],
        "title": "RunSummaryOut",
        "type": "object"
      },
      "Suite": {
        "description": "The harness's suites (``eval-harness --suite``).",
        "enum": [
          "extraction",
          "relations",
          "qa"
        ],
        "title": "Suite",
        "type": "string"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "An access token from the identity service. Read when CW_AUTH_MODE is dual or token; required when it is token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "compliancewatch-eval",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/eval/ping": {
      "get": {
        "operationId": "ping_v1_eval_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping V1 Eval Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping",
        "tags": [
          "eval"
        ]
      }
    },
    "/v1/eval/runs": {
      "get": {
        "operationId": "list_runs_v1_eval_runs_get",
        "parameters": [
          {
            "description": "Only runs of this suite",
            "in": "query",
            "name": "suite",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Suite"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only runs of this suite",
              "title": "Suite"
            }
          },
          {
            "description": "Only runs under this profile",
            "in": "query",
            "name": "profile",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Profile"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only runs under this profile",
              "title": "Profile"
            }
          },
          {
            "description": "At most this many runs",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "At most this many runs",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunSummaryOut"
                  },
                  "title": "Response List Runs V1 Eval Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Stored runs, latest first, optionally of one suite or profile",
        "tags": [
          "eval"
        ]
      },
      "post": {
        "description": "Failing gates are a result: the run is stored and ``passed`` is false. A harness that\nstops before measuring its gates is a 502 ``eval-harness-failed`` and stores nothing.",
        "operationId": "start_run_v1_eval_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Run one harness suite under a profile and store the run with its gates and drift",
        "tags": [
          "eval"
        ]
      }
    },
    "/v1/eval/runs/{run_id}": {
      "get": {
        "operationId": "get_run_v1_eval_runs__run_id__get",
        "parameters": [
          {
            "description": "The run's id",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "description": "The run's id",
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "One stored run with every gate and its drift against the previous run",
        "tags": [
          "eval"
        ]
      }
    }
  }
}
