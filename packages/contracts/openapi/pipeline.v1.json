{
  "components": {
    "schemas": {
      "CrawlRunOut": {
        "properties": {
          "duplicates": {
            "title": "Duplicates",
            "type": "integer"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "listed": {
            "title": "Listed",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CrawlStatus"
          },
          "stored": {
            "title": "Stored",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "status",
          "started_at",
          "finished_at",
          "listed",
          "stored",
          "duplicates",
          "failed",
          "error"
        ],
        "title": "CrawlRunOut",
        "type": "object"
      },
      "CrawlStatus": {
        "enum": [
          "running",
          "completed",
          "failed"
        ],
        "title": "CrawlStatus",
        "type": "string"
      },
      "CrawlTrigger": {
        "description": "Why a crawl ran: the schedule's tick, or an admin's fetch.",
        "enum": [
          "schedule",
          "manual"
        ],
        "title": "CrawlTrigger",
        "type": "string"
      },
      "DocumentOut": {
        "properties": {
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "external_ref": {
            "title": "External Ref",
            "type": "string"
          },
          "fetched_at": {
            "description": "When the bytes were first fetched",
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "published_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published On"
          },
          "raw_path": {
            "description": "Where the stored bytes are served",
            "title": "Raw Path",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "source_key": {
            "title": "Source Key",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "storage_key": {
            "title": "Storage Key",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "source_key",
          "source_url",
          "external_ref",
          "title",
          "published_on",
          "fetched_at",
          "content_type",
          "size",
          "sha256",
          "storage_key",
          "status",
          "raw_path"
        ],
        "title": "DocumentOut",
        "type": "object"
      },
      "DocumentStatus": {
        "description": "Where a stored document stands: just discovered, parsed into clauses, failed to parse,\nor set aside as not a regulatory document (a user manual listed among notifications).",
        "enum": [
          "discovered",
          "parsed",
          "failed",
          "irrelevant"
        ],
        "title": "DocumentStatus",
        "type": "string"
      },
      "DocumentType": {
        "description": "What a regulator document is. A ``statute`` is an Act or the Rules made under it (the\nCGST Act, the CGST Rules): the law the other documents amend and the rules cite. An analyst\nuploads it; it is registered and its clauses embedded, but no rule is extracted from it.",
        "enum": [
          "notification",
          "circular",
          "press_release",
          "act_amendment",
          "statute"
        ],
        "title": "DocumentType",
        "type": "string"
      },
      "FetchIn": {
        "additionalProperties": false,
        "description": "An admin's fetch of the source now.",
        "properties": {
          "actor_id": {
            "description": "The admin taking the step; a signed-in user's token overrides it, and the audit entry names whoever acted",
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "reason": {
            "description": "Why: kept verbatim in the audit entry",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "reason"
        ],
        "title": "FetchIn",
        "type": "object"
      },
      "FetchOut": {
        "description": "The crawl started: its run (``latest_run`` of the source shows it) and its workflow.",
        "properties": {
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "source_key": {
            "title": "Source Key",
            "type": "string"
          },
          "trigger": {
            "$ref": "#/components/schemas/CrawlTrigger"
          },
          "workflow_id": {
            "title": "Workflow Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "workflow_id",
          "source_key",
          "trigger"
        ],
        "title": "FetchOut",
        "type": "object"
      },
      "FreshnessOut": {
        "properties": {
          "age_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds since a crawl last listed the source",
            "title": "Age Seconds"
          },
          "cadence_seconds": {
            "title": "Cadence Seconds",
            "type": "integer"
          },
          "cadences": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "The age in cadences, two decimals",
            "title": "Cadences"
          },
          "state": {
            "$ref": "#/components/schemas/FreshnessState",
            "description": "fresh within one cadence of the last listing, late within two, stale beyond (the SourceStale alert pages then), never before the first"
          }
        },
        "required": [
          "state",
          "age_seconds",
          "cadence_seconds",
          "cadences"
        ],
        "title": "FreshnessOut",
        "type": "object"
      },
      "FreshnessState": {
        "enum": [
          "fresh",
          "late",
          "stale",
          "never"
        ],
        "title": "FreshnessState",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Page_DocumentOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DocumentOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Send as cursor to read the next page; null on the last page",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "Page[DocumentOut]",
        "type": "object"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SourceEditIn": {
        "additionalProperties": false,
        "description": "What to change; a field left out stays as it is.",
        "properties": {
          "actor_id": {
            "description": "The admin taking the step; a signed-in user's token overrides it, and the audit entry names whoever acted",
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "cadence_seconds": {
            "anyOf": [
              {
                "maximum": 2678400.0,
                "minimum": 60.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cadence Seconds"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "All of the adapter type's parameters, checked again",
            "title": "Parameters"
          },
          "paused": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused"
          },
          "reason": {
            "description": "Why: kept verbatim in the audit entry",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "reason"
        ],
        "title": "SourceEditIn",
        "type": "object"
      },
      "SourceIn": {
        "additionalProperties": false,
        "description": "A source to add: its key, name, adapter type with the type's parameters, and cadence.",
        "properties": {
          "actor_id": {
            "description": "The admin taking the step; a signed-in user's token overrides it, and the audit entry names whoever acted",
            "format": "uuid",
            "title": "Actor Id",
            "type": "string"
          },
          "adapter_type": {
            "description": "An adapter type of the registry: cbic, gstcouncil, gstn, mahagst, or upload for a source whose documents are uploaded",
            "examples": [
              "cbic"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "title": "Adapter Type",
            "type": "string"
          },
          "cadence_seconds": {
            "maximum": 2678400.0,
            "minimum": 60.0,
            "title": "Cadence Seconds",
            "type": "integer"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "key": {
            "examples": [
              "cbic_notifications"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "title": "Key",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "description": "The adapter type's parameters, which it checks: cbic takes listing (notifications or circulars) and category (one with a recorded listing); upload takes document_type (statute by default) and regulator (CBIC by default); the others take none",
            "examples": [
              {
                "category": "Central Tax",
                "listing": "notifications"
              }
            ],
            "title": "Parameters",
            "type": "object"
          },
          "paused": {
            "default": false,
            "title": "Paused",
            "type": "boolean"
          },
          "reason": {
            "description": "Why: kept verbatim in the audit entry",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "reason",
          "key",
          "name",
          "adapter_type",
          "cadence_seconds"
        ],
        "title": "SourceIn",
        "type": "object"
      },
      "SourceOut": {
        "properties": {
          "adapter_type": {
            "title": "Adapter Type",
            "type": "string"
          },
          "cadence_seconds": {
            "title": "Cadence Seconds",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "doc_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentType"
              },
              {
                "type": "null"
              }
            ]
          },
          "document_count": {
            "title": "Document Count",
            "type": "integer"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "freshness": {
            "$ref": "#/components/schemas/FreshnessOut"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "last_error": {
            "title": "Last Error",
            "type": "string"
          },
          "last_fetch_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When a crawl last listed the source",
            "title": "Last Fetch At"
          },
          "latest_run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CrawlRunOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "listable": {
            "description": "Whether the source lists documents, so the schedule crawls it; an upload-only source (the statutes) does not, and its documents are uploaded",
            "title": "Listable",
            "type": "boolean"
          },
          "name": {
            "description": "The source's name, or its key when it has none",
            "title": "Name",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "paused": {
            "title": "Paused",
            "type": "boolean"
          },
          "regulator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "From the adapter type; null when the code cannot read the source's type",
            "title": "Regulator"
          },
          "site": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site"
          },
          "status": {
            "$ref": "#/components/schemas/SourceStatus",
            "description": "fetching while a crawl runs, else paused while paused or disabled, failing when the last crawl recorded an error, healthy otherwise"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "watermark": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The newest publication date up to which every listed document is stored",
            "title": "Watermark"
          }
        },
        "required": [
          "key",
          "name",
          "adapter_type",
          "parameters",
          "regulator",
          "site",
          "doc_type",
          "listable",
          "cadence_seconds",
          "enabled",
          "paused",
          "status",
          "document_count",
          "last_fetch_at",
          "freshness",
          "last_error",
          "watermark",
          "latest_run",
          "created_at",
          "updated_at"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "SourceStatus": {
        "enum": [
          "healthy",
          "fetching",
          "failing",
          "paused"
        ],
        "title": "SourceStatus",
        "type": "string"
      },
      "SourcesOut": {
        "properties": {
          "items": {
            "description": "Every source, by key",
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SourcesOut",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "An access token from the identity service. Read when CW_AUTH_MODE is dual or token; required when it is token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "compliancewatch-pipeline",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/pipeline/documents/{document_id}": {
      "get": {
        "description": "A stored document as its record holds it: where it was listed, what the listing said,\nwhen it was first fetched, its digest, storage key and status.",
        "operationId": "read_document_v1_pipeline_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read one stored document",
        "tags": [
          "pipeline"
        ]
      }
    },
    "/v1/pipeline/documents/{document_id}/raw": {
      "get": {
        "description": "The bytes the raw store keeps for the document, served with the content type it was\nfetched with once their SHA-256 matches the record's (502 when the stored file is missing or\naltered, 503 when the raw store does not answer). The ETag is the digest; the bytes under it\nnever change. The response is served inline, sandboxed and never sniffed.",
        "operationId": "read_raw_v1_pipeline_documents__document_id__raw_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/pdf": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The bytes, with their content type"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
