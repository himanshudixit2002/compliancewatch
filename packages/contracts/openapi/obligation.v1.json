{
  "components": {
    "schemas": {
      "ClosureReason": {
        "description": "Why an obligation was closed; decides the closing status.",
        "enum": [
          "profile_changed",
          "rule_withdrawn",
          "rule_superseded",
          "waived_by_user",
          "completed"
        ],
        "title": "ClosureReason",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ObligationOut": {
        "description": "One obligation: due_at is the end of the due day in India, given in UTC. The period is\nhalf-open (period_end is the day after its last day), and null for a rule that does not\nrecur.",
        "properties": {
          "business_id": {
            "format": "uuid",
            "title": "Business Id",
            "type": "string"
          },
          "closed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "closed_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClosureReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision_id": {
            "format": "uuid",
            "title": "Decision Id",
            "type": "string"
          },
          "due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At"
          },
          "evidence_type": {
            "title": "Evidence Type",
            "type": "string"
          },
          "obligation_id": {
            "format": "uuid",
            "title": "Obligation Id",
            "type": "string"
          },
          "period_end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period End"
          },
          "period_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Label"
          },
          "period_start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Start"
          },
          "rule_version_id": {
            "format": "uuid",
            "title": "Rule Version Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ObligationStatus"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "obligation_id",
          "business_id",
          "rule_version_id",
          "decision_id",
          "title",
          "steps",
          "evidence_type",
          "period_label",
          "period_start",
          "period_end",
          "due_at",
          "status",
          "closed_at",
          "closed_reason"
        ],
        "title": "ObligationOut",
        "type": "object"
      },
      "ObligationStatus": {
        "enum": [
          "open",
          "in_progress",
          "done",
          "waived",
          "closed_not_applicable"
        ],
        "title": "ObligationStatus",
        "type": "string"
      },
      "Problem": {
        "description": "The body of every error response.",
        "properties": {
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Correlation Id"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One failed check on the request. The submitted value is not echoed back.",
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "An access token from the identity service. Read when CW_AUTH_MODE is dual or token; required when it is token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "compliancewatch-obligation",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/obligation/obligations": {
      "get": {
        "operationId": "list_obligations_v1_obligation_obligations_get",
        "parameters": [
          {
            "description": "The profile node the obligations are for",
            "in": "query",
            "name": "business_id",
            "required": true,
            "schema": {
              "description": "The profile node the obligations are for",
              "format": "uuid",
              "title": "Business Id",
              "type": "string"
            }
          },
          {
            "description": "First due day, in India (inclusive)",
            "in": "query",
            "name": "due_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First due day, in India (inclusive)",
              "title": "Due From"
            }
          },
          {
            "description": "Last due day, in India (inclusive); at most 366 days",
            "in": "query",
            "name": "due_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last due day, in India (inclusive); at most 366 days",
              "title": "Due To"
            }
          },
          {
            "description": "Only obligations of this rule version",
            "in": "query",
            "name": "rule_version_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only obligations of this rule version",
              "title": "Rule Version Id"
            }
          },
          {
            "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
            "in": "header",
            "name": "x-tenant-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tenant UUID. A user's access token names the tenant, so a user leaves the header out or repeats that tenant; a service token names one here with the tenant:act scope.",
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ObligationOut"
                  },
                  "title": "Response List Obligations V1 Obligation Obligations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "A business's obligations, due date first, optionally inside a window of days",
        "tags": [
          "obligation"
        ]
      }
    },
    "/v1/obligation/ping": {
      "get": {
        "operationId": "ping_v1_obligation_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ping V1 Obligation Ping Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ping",
        "tags": [
          "obligation"
        ]
      }
    }
  }
}
