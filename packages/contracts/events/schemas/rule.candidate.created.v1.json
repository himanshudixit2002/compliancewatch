{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compliancewatch:event:rule.candidate.created:v1",
  "title": "rule.candidate.created",
  "description": "The extractor produced a rule candidate from a parsed document; the candidate itself is read from the store. Producer: pipeline (rule extractor). Consumers: pipeline (review).",
  "type": "object",
  "x-version": "1.0.0",
  "x-producer": "pipeline (rule extractor)",
  "x-tenant-scoped": false,
  "properties": {
    "candidate_id": {
      "type": "string",
      "format": "uuid",
      "description": "The candidate."
    },
    "document_id": {
      "type": "string",
      "format": "uuid",
      "description": "The document it was extracted from."
    },
    "regulator": {
      "type": "string",
      "minLength": 1,
      "description": "Regulator the document belongs to."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model that produced the candidate."
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Prompt reference as name@version."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Extractor confidence in [0, 1]."
    },
    "citation_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Citations that verified against the clause text."
    },
    "needs_review": {
      "type": "boolean",
      "description": "True when the confidence is below the review threshold or a check failed."
    }
  },
  "required": [
    "candidate_id",
    "document_id",
    "regulator",
    "model",
    "prompt_version",
    "confidence",
    "citation_count",
    "needs_review"
  ]
}
