{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compliancewatch:event:applicability.decided:v1",
  "title": "applicability.decided",
  "description": "The engine evaluated one rule version against one business profile version. Producer: applicability-engine. Consumers: obligation.",
  "type": "object",
  "x-version": "1.0.0",
  "x-producer": "applicability-engine",
  "x-tenant-scoped": true,
  "properties": {
    "decision_id": {
      "type": "string",
      "format": "uuid",
      "description": "The stored decision."
    },
    "business_id": {
      "type": "string",
      "format": "uuid",
      "description": "The business evaluated."
    },
    "rule_version_id": {
      "type": "string",
      "format": "uuid",
      "description": "The rule version evaluated."
    },
    "result": {
      "type": "string",
      "enum": ["applies", "not_applicable", "unsure"],
      "description": "Three-valued outcome."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in [0, 1]; 1 for fully deterministic evaluations."
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Profile version the decision was computed from."
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the decision was made."
    },
    "needs_review": {
      "type": "boolean",
      "description": "True when the result is unsure or the confidence is below the review threshold."
    },
    "trigger": {
      "type": "string",
      "enum": ["rule_published", "profile_updated", "manual"],
      "description": "What caused the evaluation."
    }
  },
  "required": [
    "decision_id",
    "business_id",
    "rule_version_id",
    "result",
    "confidence",
    "profile_version",
    "decided_at",
    "needs_review",
    "trigger"
  ]
}
