{
  "consumer": "whatsapp-bot",
  "provider": "notification",
  "interactions": [
    {
      "description": "a keyword opt-in is stored as the number's preference",
      "request": {
        "method": "PUT",
        "path": "/v1/notification/preferences/whatsapp/919876543210",
        "headers": { "content-type": "application/json" },
        "body": { "opted_in": true, "source": "whatsapp_keyword", "language": "en" }
      },
      "response": {
        "status": 200,
        "body": {
          "channel": "whatsapp",
          "recipient": "919876543210",
          "opted_in": true,
          "source": "whatsapp_keyword",
          "language": "en"
        }
      }
    },
    {
      "description": "the number reads back as opted in",
      "request": { "method": "GET", "path": "/v1/notification/preferences/whatsapp/919876543210" },
      "response": { "status": 200, "body": { "opted_in": true } }
    },
    {
      "description": "a keyword opt-out in Hindi replaces the opt-in",
      "request": {
        "method": "PUT",
        "path": "/v1/notification/preferences/whatsapp/919876543210",
        "headers": { "content-type": "application/json" },
        "body": { "opted_in": false, "source": "whatsapp_keyword", "language": "hi" }
      },
      "response": {
        "status": 200,
        "body": { "recipient": "919876543210", "opted_in": false, "language": "hi" }
      }
    },
    {
      "description": "the number reads back as opted out",
      "request": { "method": "GET", "path": "/v1/notification/preferences/whatsapp/919876543210" },
      "response": { "status": 200, "body": { "opted_in": false } }
    },
    {
      "description": "a number that never wrote a keyword has no preference",
      "request": { "method": "GET", "path": "/v1/notification/preferences/whatsapp/919999999999" },
      "response": { "status": 404, "body": { "status": 404 } }
    }
  ]
}
