# Copy to .env for local runs (loaded by `pnpm dev` via --env-file-if-exists). Placeholders only.
PORT=8080
# Meta app dashboard -> WhatsApp -> Configuration: the verify token you choose and the app secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# false only for local runs without an app secret; deliveries are rejected otherwise.
WHATSAPP_REQUIRE_SIGNATURE=true
# Replies leave the process only when true and both values below are set (manual steps in docs/runbooks/whatsapp.md).
WHATSAPP_SEND_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# The bot's own access token from the identity service at IDENTITY_API_URL (below). With the
# secret set, the bot exchanges its client id and secret at identity and every call to
# notification and identity carries the token (Authorization: Bearer), which those services need
# when their CW_AUTH_MODE is token. Locally identity creates the whatsapp-bot client when its
# CW_IDENTITY_DEV_CLIENT_SECRET is set; use the same value here. Empty: no token is sent and only
# the shared tokens below apply, as before.
BOT_SERVICE_CLIENT_ID=whatsapp-bot
BOT_SERVICE_CLIENT_SECRET=
# The notification service that records opt-ins and opt-outs and takes the delivery statuses.
NOTIFICATION_API_URL=http://localhost:8006
# The shared secret of notification's receipt route (its CW_NOTIFICATION_BOT_TOKEN). With it or the
# service token, every webhook delivery's statuses and inbound times are forwarded before any
# message is handled; without either they are not, and the bot warns once at start. Notification
# in token mode takes the service token alone.
NOTIFICATION_BOT_TOKEN=
# Keyword opt-ins and opt-outs recorded as consents in the identity service. Off by default
# (owner core-product); removed once the lawyer confirms keyword opt-in is valid consent. On, the
# bot needs IDENTITY_SERVICE_TOKEN (the value of identity's CW_IDENTITY_CHANNEL_TOKEN) or the
# service token, and refuses to start without either.
WHATSAPP_CONSENT_RECORDING_ENABLED=false
IDENTITY_API_URL=http://localhost:8001
IDENTITY_SERVICE_TOKEN=
# The Version: line of docs/legal/whatsapp-consent.md that the opt-in prompt shows.
WHATSAPP_NOTICE_VERSION=whatsapp-consent 0.1-draft
