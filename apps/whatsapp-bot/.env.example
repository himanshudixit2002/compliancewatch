# Copy to .env for local runs (loaded by `pnpm dev` via --env-file-if-exists). Placeholders only.
PORT=8080
# Meta app dashboard -> WhatsApp -> Configuration: the verify token you choose and the app secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# false only for local runs without an app secret; deliveries are rejected otherwise.
WHATSAPP_REQUIRE_SIGNATURE=true
# Replies leave the process only when true and both values below are set (manual steps in docs/runbooks/whatsapp.md).
WHATSAPP_SEND_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# The notification service that records opt-ins and opt-outs.
NOTIFICATION_API_URL=http://localhost:8006
# Keyword opt-ins and opt-outs recorded as consents in the identity service. Off by default
# (owner core-product); removed once the lawyer confirms keyword opt-in is valid consent. On, the
# bot needs IDENTITY_SERVICE_TOKEN (the value of identity's CW_IDENTITY_CHANNEL_TOKEN) and
# refuses to start without it.
WHATSAPP_CONSENT_RECORDING_ENABLED=false
IDENTITY_API_URL=http://localhost:8001
IDENTITY_SERVICE_TOKEN=
# The Version: line of docs/legal/whatsapp-consent.md that the opt-in prompt shows.
WHATSAPP_NOTICE_VERSION=whatsapp-consent 0.1-draft
