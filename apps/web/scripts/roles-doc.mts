import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { format, resolveConfig } from "prettier";
import { CAPABILITIES, CAPABILITY_NAMES } from "../src/shared/config/permissions.ts";
import {
  ALLOWED_ROLES,
  MFA_REQUIRED_ROLES,
  REGULATORY_ROLES,
  ROLES,
  TENANT_ADMIN_ROLES,
  TENANT_KINDS,
  TENANT_MEMBER_ROLES,
  firstRoleFor,
} from "../src/shared/config/roles.ts";
import type { Role } from "../src/shared/config/roles.ts";
import { SCREENS } from "../src/shared/config/screens.ts";
import type { Screen } from "../src/shared/config/screens.ts";

/**
 * Renders docs/web/roles.md from the role configuration and the screen registry: the roles
 * with their tenant kinds and sets, the capability matrix, and the role-to-route matrix of
 * the live pages and handlers. Runs under plain Node like screens-doc.mts, and ends with
 * prettier. `node scripts/roles-doc.mts` writes the file; `--check` exits 1 when the committed
 * file differs. src/test/roles-doc.test.ts performs the same comparison, so `pnpm test` catches
 * drift.
 */
const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url));
export const REPO_ROOT = resolve(SCRIPT_DIR, "../../..");
export const OUTPUT_PATH = join(REPO_ROOT, "docs/web/roles.md");

const code = (text: string): string => `\`${text}\``;
const cell = (text: string): string => text.replace(/\|/g, "\\|");

const SECTION_HEADINGS: Record<Screen["section"], string> = {
  system: "System",
  owner: "Owner and staff",
  ca: "CA firm",
  account: "Account",
  admin: "Internal tools",
};

function kindsOf(role: Role): string {
  return TENANT_KINDS.filter((kind) => ALLOWED_ROLES[kind].includes(role)).join(", ");
}

function setsOf(role: Role): string {
  const sets: string[] = [];
  if (TENANT_MEMBER_ROLES.includes(role)) sets.push("tenant member");
  if (TENANT_ADMIN_ROLES.includes(role)) sets.push("tenant admin");
  if (REGULATORY_ROLES.includes(role)) sets.push("regulatory");
  if (MFA_REQUIRED_ROLES.includes(role)) sets.push("needs a second factor");
  return sets.join(", ");
}

function firstOf(role: Role): string {
  const kinds = TENANT_KINDS.filter((kind) => firstRoleFor(kind) === role);
  return kinds
    .map((kind) => `first user of ${kind === "internal" ? "an" : "a"} ${kind} tenant`)
    .join("; ");
}

function rolesTable(): string[] {
  const lines = ["| Role | Tenant kinds | Sets | First user |", "| --- | --- | --- | --- |"];
  for (const role of ROLES) {
    lines.push(`| ${[code(role), kindsOf(role), setsOf(role), firstOf(role)].join(" | ")} |`);
  }
  return lines;
}

function capabilitiesTable(): string[] {
  const header = ["Capability", ...ROLES];
  const lines = [`| ${header.join(" | ")} |`, `| ${header.map(() => "---").join(" | ")} |`];
  for (const name of CAPABILITY_NAMES) {
    const granted: readonly Role[] = CAPABILITIES[name];
    const marks = ROLES.map((role) => (granted.includes(role) ? "x" : ""));
    lines.push(`| ${[code(name), ...marks].join(" | ")} |`);
  }
  return lines;
}

function routeMatrix(screens: readonly Screen[]): string[] {
  const header = ["Route", "Title", "Tenant kinds", "Public", ...ROLES];
  const lines = [`| ${header.join(" | ")} |`, `| ${header.map(() => "---").join(" | ")} |`];
  for (const screen of screens) {
    const marks = ROLES.map((role) =>
      screen.roles !== "public" && screen.roles.includes(role) ? "x" : "",
    );
    const isPublic = screen.roles === "public" ? "x" : "";
    const kinds = screen.tenantKinds === undefined ? "any" : screen.tenantKinds.join(", ");
    lines.push(
      `| ${[code(screen.route), cell(screen.title), kinds, isPublic, ...marks].join(" | ")} |`,
    );
  }
  return lines;
}

/** The markdown before formatting. */
export function renderRolesDoc(screens: readonly Screen[] = SCREENS): string {
  const live = screens.filter(
    (screen) => screen.status === "live" && (screen.kind === "page" || screen.kind === "handler"),
  );
  const lines: string[] = [
    "# Roles",
    "",
    "Generated by `pnpm --filter web roles:gen` from `apps/web/src/shared/config/roles.ts`,",
    "`permissions.ts` and `screens.ts`. Do not edit by hand: `pnpm --filter web roles:check` and the",
    "vitest test `src/test/roles-doc.test.ts` fail when this file and the configuration differ.",
    "`roles-parity.test.ts` holds `roles.ts` to the kernel's `domain_kernel/access.py` and identity's",
    "`domain/tenancy.py`, so what is here is what every service enforces.",
    "",
    "## Roles and tenant kinds",
    "",
    "A person holds one or more roles in one tenant; the tenant's kind decides which roles it may",
    "give. The sets are what the gates and the capabilities are written in: tenant members act",
    "inside a business or a CA firm, tenant admins manage its people (the last active one cannot be",
    "demoted or disabled), the regulatory roles open `/admin`, and the roles that need a second",
    "factor sign in only with one (identity refuses the exchange otherwise, and the admin tools and",
    "the team pages send a session without one to `/account/mfa`).",
    "",
    ...rolesTable(),
    "",
    "## Capabilities",
    "",
    "What an action asks for (`can(principal, capability)` in `shared/config/permissions.ts`),",
    "granted per role. A screen checks its registry entry; an action checks its capability.",
    "",
    ...capabilitiesTable(),
    "",
    "## Roles by route",
    "",
    `The live pages and route handlers (${live.length} of the registry's ${screens.length} entries) and who may open each: the`,
    "entry's roles, or public, narrowed by its tenant kinds. The admin section answers 404, not",
    "`/forbidden`, to a tenant role, and the `/admin` allow-list (`CW_WEB_ADMIN_IP_ALLOWLIST`) applies",
    "before any role is read.",
  ];
  for (const section of Object.keys(SECTION_HEADINGS) as Screen["section"][]) {
    const rows = live.filter((screen) => screen.section === section);
    if (rows.length === 0) continue;
    lines.push("", `### ${SECTION_HEADINGS[section]}`, "", ...routeMatrix(rows));
  }
  lines.push("");
  return lines.join("\n");
}

/** The markdown as prettier formats it with the repository's configuration. */
export async function formatRolesDoc(markdown: string): Promise<string> {
  const options = (await resolveConfig(OUTPUT_PATH)) ?? {};
  return format(markdown, { ...options, parser: "markdown" });
}

async function main(args: string[]): Promise<number> {
  const expected = await formatRolesDoc(renderRolesDoc());
  if (args.includes("--check")) {
    let committed = "";
    try {
      committed = readFileSync(OUTPUT_PATH, "utf8");
    } catch {
      committed = "";
    }
    if (committed !== expected) {
      console.error("docs/web/roles.md is out of date: run pnpm --filter web roles:gen");
      return 1;
    }
    console.log("docs/web/roles.md matches the configuration");
    return 0;
  }
  writeFileSync(OUTPUT_PATH, expected);
  console.log(
    `wrote docs/web/roles.md (${ROLES.length} roles, ${CAPABILITY_NAMES.length} capabilities)`,
  );
  return 0;
}

const invokedDirectly =
  process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url);
if (invokedDirectly) {
  process.exitCode = await main(process.argv.slice(2));
}
