# Local settings for the web app. Copy to apps/web/.env.local (git-ignored); Next.js loads it for
# `next dev`, `next build` and `next start`. Everything here is read on the server by
# src/server/env.ts, validated with zod at the first request (never at build time), and nothing
# reaches the browser: the app has no NEXT_PUBLIC_* variable and a page never calls a service.
# Placeholder values only; never a real secret (gitleaks runs in pre-commit and CI).

# Runtime environment: local | test | staging | prod. Unset means local; any other value is
# refused, with the variable's name, at the first request. The design catalogue (/design) and the
# fake sign-in exist only in local and test, and the internal shell shows this name.
CW_WEB_ENV=local

# Sign-in provider. fake: local and test only; picks a tenant, its kind, roles and a display name.
# supabase: reserved for the identity work and refused until its adapter exists. Unset: sign-in is
# not configured and the sign-in page says so.
CW_WEB_AUTH_PROVIDER=fake

# 32 random bytes as base64, the key of the encrypted session cookie. Generate your own with
#   openssl rand -base64 32
# Needed only where a session is created or read; the build and the public pages run without it.
CW_WEB_SESSION_SECRET=
# Session lifetime in seconds: default 28800 (eight hours), at most 86400.
# CW_WEB_SESSION_TTL_SECONDS=28800

# Service base URLs, read on the server only. The defaults are the repository's canonical ports,
# the Makefile's SERVICES order (identity 8001 ... pipeline 8010), which is where `make web-stack`
# starts every service with SERVICE_PORT_BASE=8000 in the root .env. A second working copy of the
# repository (docs/onboarding/local-dev.md, "Running a second clone") sets SERVICE_PORT_BASE=9200
# there, so its stack listens on 9201-9210, and sets these to http://localhost:9201 ...
# http://localhost:9210 here.
# CW_WEB_IDENTITY_URL=http://localhost:8001
# CW_WEB_PROFILE_URL=http://localhost:8002
# CW_WEB_RULEBOOK_URL=http://localhost:8003
# CW_WEB_APPLICABILITY_ENGINE_URL=http://localhost:8004
# CW_WEB_OBLIGATION_URL=http://localhost:8005
# CW_WEB_NOTIFICATION_URL=http://localhost:8006
# CW_WEB_QA_URL=http://localhost:8007
# CW_WEB_LLM_GATEWAY_URL=http://localhost:8008
# CW_WEB_EVAL_URL=http://localhost:8009
# CW_WEB_PIPELINE_URL=http://localhost:8010

# Time limit per service call in milliseconds: default 10000, at most 120000.
# CW_WEB_REQUEST_TIMEOUT_MS=10000

# The rulebook's shared write token (the service's CW_RULEBOOK_WRITE_TOKEN), sent only by the
# server-side admin write client after a regulatory-role check. The pipeline reads the same value
# (its copy of CW_RULEBOOK_WRITE_TOKEN), and server/api/pipeline-write.ts sends it there for an
# admin's source and pipeline writes only. Unset: those writes report that they are not
# configured instead of calling the service. The local stack and CI both use the placeholder
# local-write-token; it is not a secret.
# CW_WEB_RULEBOOK_WRITE_TOKEN=local-write-token

# The largest file the upload handler (/api-bff/pipeline/sources/[key]/uploads) forwards, in
# bytes: default 25000000 (25 MB), at most 100000000. Keep it equal to the pipeline's
# CW_PIPELINE_UPLOAD_MAX_BYTES, which refuses anything larger anyway.
# CW_WEB_PIPELINE_UPLOAD_MAX_BYTES=25000000

# The rulebook's review token (the service's CW_RULEBOOK_REVIEW_TOKEN), sent only by
# server/api/rulebook-write.ts with an analyst's entity and relation decisions (while the
# web.admin_rulebook_writes flag is on) and with the citations and the publish workflow steps of a
# rule version (while web.publish_actions is on), after a regulatory-role check. Unset: those
# actions report that they are not configured instead of calling the service. make web-stack gives
# the rulebook the placeholder local-review-token (not a secret); to use the workflow against it
# from next dev, set this to that value and CW_WEB_FLAG_PUBLISH_ACTIONS=true, and to decide entity
# groups and relation candidates CW_WEB_FLAG_ADMIN_RULEBOOK_WRITES=true (local and test only).
# CW_WEB_RULEBOOK_REVIEW_TOKEN=

# Comma-separated IPs or CIDRs allowed to open /admin. Empty: every address in local and test,
# none elsewhere (/admin answers 404). The client address is taken from x-real-ip or the first
# x-forwarded-for hop only when CW_WEB_TRUST_FORWARDED_IP is true (behind a proxy you control);
# the same switch lets the sign-out origin check read the host from x-forwarded-host.
# CW_WEB_ADMIN_IP_ALLOWLIST=10.0.0.0/8
# CW_WEB_TRUST_FORWARDED_IP=false

# Where the seed script records the last seeded tenant, relative to apps/web.
# CW_WEB_SEED_STATE_PATH=../../var/seed/last.json

# The build's commit, shown by /api/health; set by the deployment.
# CW_WEB_BUILD_SHA=

# OpenTelemetry, behind the flag web.otel_enabled (off by default; CW_WEB_FLAG_OTEL_ENABLED=true
# turns it on in local and test, Unleash elsewhere). With the flag on, spans leave the web server
# only when an OTLP endpoint is set (OTLP over HTTP; the compose collector listens on
# OTEL_HTTP_PORT, 4318 unless the root .env moves it). docs/web/feature-flags.md has the detail.
# CW_WEB_FLAG_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The port is not set here: Next.js reads PORT from the process, and `make web-dev` and
# `make web-e2e` pass WEB_PORT from the root .env (3000 unless changed; a second working copy
# sets 3200 there).
